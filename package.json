{
  "name": "better-clickup",
  "productName": "Better ClickUp",
  "appId": "com.wimvdon.betterclickup",
  "description": "A lighter ClickUp desktop app for Windows with tabs, sleeping tabs and notifications.",
  "version": "0.0.0-dev",
  "author": "wimvdon",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "autoUpdate": false,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "dist": "electron-vite build && electron-builder --config electron-builder.config.mjs --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.345",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.10.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": false
  }
}
