{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "electron-builder.config.mjs"
  ]
}
